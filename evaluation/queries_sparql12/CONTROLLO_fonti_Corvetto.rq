VERSION "1.2"
# SPARQL 1.2, triple terms non assertivi
PREFIX : <https://example.org/lexint/maranza/>
PREFIX lexint: <https://lexo.ilc.cnr.it/vocabulary/lexical-interpretation#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX lemonEty: <http://lari-datasets.ilc.cnr.it/lemonEty#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX frac: <http://www.w3.org/ns/lemon/frac#>
PREFIX hico: <http://purl.org/emmedi/hico/>
PREFIX crminf: <http://www.cidoc-crm.org/extensions/crminf/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX cito: <http://purl.org/spar/cito/>

# Controllo mirato: provenienza primaria, mediazione secondaria e citazione testuale.
SELECT ?attestazione ?fontePrimaria ?titoloPrimaria ?fonteMediatrice ?titoloMediatrice
WHERE {
  BIND(:attCorvetto2009 AS ?attestazione)
  ?attestazione a frac:Attestation ;
    frac:observedIn ?fontePrimaria ;
    prov:wasDerivedFrom ?fonteMediatrice .
  ?fontePrimaria dcterms:title ?titoloPrimaria .
  ?fonteMediatrice dcterms:title ?titoloMediatrice ;
    cito:cites ?fontePrimaria .
  FILTER NOT EXISTS { ?attestazione frac:quotedText ?testo }
}
